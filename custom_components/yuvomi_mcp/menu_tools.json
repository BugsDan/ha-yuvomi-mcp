[
  {
    "type": "function",
    "function": {
      "name": "yuvomi_mcp__get_menu_planning_context",
      "description": "For explicit menu planning, day changes or suggestions only. Whole-period planning requires a deliberately separate conversation. Load rules, attendance and recipes; requested_recipe restricts day changes to its exact variant. Return context_id for save_menu_plan. Existing slots protected; suggestions never write. No automatic session isolation.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create_period",
              "replace_day",
              "suggest_day"
            ]
          },
          "period": {
            "type": "string",
            "enum": [
              "current",
              "next"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "requested_recipe": {
            "type": "string",
            "description": "Exact user-named recipe title/variant, if any; bind context to one unambiguous recipe."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "yuvomi_mcp__save_menu_plan",
      "description": "Save Gemma-selected assignments only within the bound planning context. New plans fill free slots; explicit day changes replace only that authorized slot. Backend validates dates, portions and hard rules. Never sync shopping. No blind retry on uncertain/partial results.",
      "parameters": {
        "type": "object",
        "properties": {
          "context_id": {
            "type": "string"
          },
          "assignments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "recipe_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "cook",
                    "reheat",
                    "rest",
                    "emergency"
                  ]
                },
                "source_date": {
                  "type": "string",
                  "format": "date",
                  "description": "For reheat: exact source cooking date from this context."
                },
                "extra_servings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "profile_id": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string",
                        "format": "date"
                      },
                      "servings": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "profile_id",
                      "date",
                      "servings"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "date",
                "recipe_id",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "context_id",
          "assignments"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "yuvomi_mcp__get_menu_plan",
      "description": "Read saved meals, not full planning context. Default response is today/tomorrow within the requested period; full plan only on explicit request. No planning or shopping writes by HA; Yuvomi may materialize recurring entries on read.",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "period": {
            "type": "string",
            "enum": [
              "current",
              "next"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "detail": {
            "type": "string",
            "enum": [
              "brief",
              "full"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  }
]
